      "parameters": {
        "jsCode": "const input = items[0].json;\nconst features = input.features || [];\n\nif (!Array.isArray(features) || features.length === 0) {\n  return [];\n}\n\nreturn features.map(f => {\n  const props = f.properties || {};\n  const geom = f.geometry || {};\n  const coords = geom.coordinates || [];\n\n  return {\n    json: {\n      eventid: String(f.id),\n      eventtype: \"EQ\",\n      eventdate: props.time ? new Date(props.time).toISOString() : null,\n      latitude: coords[1],\n      longitude: coords[0],\n      magnitude: props.mag ?? null,\n      depth: coords[2] ?? null,\n      source: \"USGS\",\n      raw: f\n    }\n  };\n});\n"
      },
